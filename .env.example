# ── Banco de dados ─────────────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:SUASENHA@localhost:5432/qfin

# ── JWT (mude em produção!) ────────────────────────────────────────────────
JWT_SECRET=minha_chave_secreta_longa_e_segura_123456

# ── Servidor ───────────────────────────────────────────────────────────────
PORT=3000

# ── App (URL da API) ───────────────────────────────────────────────────────
# Para WEB: use localhost
# EXPO_PUBLIC_API_URL=http://localhost:3000/api

# Para ANDROID: use o IP da sua máquina (rode 'ipconfig' no CMD para saber)
EXPO_PUBLIC_API_URL=http://192.168.100.105:3000/api

# ── Email (recuperação de senha) — opcional ────────────────────────────────
# Sem isso, o código aparece no terminal do servidor
# EMAIL_USER=seuemail@gmail.com
# EMAIL_PASS=xxxx xxxx xxxx xxxx  (Senha de App do Gmail)
